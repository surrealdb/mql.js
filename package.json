{
	"name": "@surrealdb/mql",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"description": "A MongoDB-compatible driver powered by SurrealDB.",
	"keywords": [
		"surrealdb",
		"mongodb",
		"mql",
		"driver",
		"database",
		"javascript",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/mql.js.git"
	},
	"homepage": "https://github.com/surrealdb/mql.js",
	"packageManager": "^bun@1.1.17",
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@types/bun": "latest",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.21.5",
		"esbuild-plugin-tsc": "^0.4.0",
		"mongoose": "^9.2.1"
	},
	"peerDependencies": {
		"typescript": "^5.0.0",
		"tslib": "^2.6.3"
	},
	"dependencies": {
		"surrealdb": "^1.1.0"
	},
	"scripts": {
		"ts": "tsc --watch --noEmit true --emitDeclarationOnly false",
		"type-check": "tsc --noEmit",
		"quality:check": "biome check .",
		"quality:apply": "biome check . --write",
		"quality:apply:unsafe": "biome check . --write --unsafe",
		"build": "bun run scripts/build.ts",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"browser": "./dist/index.bundled.mjs",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.bundled.mjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	]
}
