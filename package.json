{
	"name": "@surrealdb/mql",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"description": "A MongoDB-compatible driver powered by SurrealDB.",
	"keywords": [
		"surrealdb",
		"mongodb",
		"mql",
		"driver",
		"database",
		"javascript",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/mql.js.git"
	},
	"homepage": "https://github.com/surrealdb/mql.js",
	"packageManager": "^bun@1.1.17",
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@types/bun": "latest",
		"@types/semver": "^7.7.1",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.21.5",
		"esbuild-plugin-tsc": "^0.4.0",
		"mongodb": "^7.2.0",
		"mongodb-memory-server": "^11.1.0",
		"mongoose": "^9.2.1",
		"semver": "^7.7.4",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"surrealdb": "^2.0.3"
	},
	"scripts": {
		"ts": "tsc --watch --noEmit true --emitDeclarationOnly false",
		"type-check": "tsc --noEmit",
		"quality:check": "biome check .",
		"quality:apply": "biome check . --write",
		"quality:apply:unsafe": "biome check . --write --unsafe",
		"build": "bun run scripts/build.ts",
		"prepublishOnly": "bun run build",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test:e2e": "bun test tests/e2e",
		"test:e2e:mongodb": "E2E_DRIVER=mongodb bun test tests/e2e",
		"test:e2e:mql": "E2E_DRIVER=mql bun test tests/e2e",
		"test:e2e:in-memory": "bun test tests/e2e/parity-in-memory.test.ts",
		"test:e2e:in-memory:mongodb": "E2E_DRIVER=mongodb bun test tests/e2e/parity-in-memory.test.ts",
		"test:e2e:in-memory:mql": "E2E_DRIVER=mql bun test tests/e2e/parity-in-memory.test.ts",
		"test:integration:3.0": "MQL_SURREAL_VERSION=3.0.5 bun test tests/integration",
		"test:integration:3.1": "MQL_SURREAL_VERSION=3.1.5 bun test tests/integration",
		"test:integration:3.2": "MQL_SURREAL_VERSION=3.2.4 bun test tests/integration"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"browser": "./dist/index.bundled.mjs",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"browser": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.bundled.mjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"COMPATIBILITY.md"
	],
	"sideEffects": false,
	"module": "./dist/index.mjs"
}
